uint16_t cl(float s) {
  int r = 0;
  int gc = 0;
  if (s < 25.0) {
    r = (s / 25.0) * 31.0;
    gc = 63;
  } else if (s < 60.0) {
    r = 31;
    gc = 63.0 - (((s - 25.0) / 35.0) * 63.0);
  } else {
    r = 31;
    gc = 0;
  }
  return (r << 11) | (gc << 5);
}

