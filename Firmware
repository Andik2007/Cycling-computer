}

void p_js(String fn) {
  File st = SD.open(fn);
  if (!st) {
    return;
  }
  
  if (SD.exists("/map.bin")) {
    SD.remove("/map.bin");
  }
  File fm = SD.open("/map.bin", FILE_WRITE);
  
  int tp = 0; 
  float pl = 0.0, pn = 0.0;
  String b = "";
  int ps = 0; 
  String s1 = "", s2 = "";
  
  while (st.available()) {
    char c = st.read();
    
    if (c == ' ' || c == '\n' || c == '\r' || c == '\t') {
      continue;
    }
    
    b += c;
    if (b.length() > 30) {
      b.remove(0, 1);
    }
    
    if (b.indexOf("\"coordinates\"") >= 0 || b.indexOf("\"Feature\"") >= 0) {
      tp = 0; pl = 0.0; pn = 0.0;
      b = "";
    } else if (b.indexOf("\"asphalt\"") >= 0 || b.indexOf("\"paved\"") >= 0) {
      tp = 1;
      b = "";
    } else if (b.indexOf("\"gravel\"") >= 0 || b.indexOf("\"dirt\"") >= 0) {
      tp = 2;
      b = "";
    }
    
    if (c == '[') {
      ps = 1; 
      s1 = ""; s2 = "";
    } else if (c == ',') {
      if (ps == 1) {
        ps = 2; 
      } else {
        ps = 0; 
      }
    } else if (c == ']') {
      if (ps == 2) {
        if (s1.length() > 0) {
          if (s2.length() > 0) {
            float nn = s1.toFloat();
            float lt = s2.toFloat();
            if (nn != 0.0 && lt != 0.0) {
              if (pl != 0.0 && pn != 0.0) {
                uint8_t t_out = tp;
                fm.write(&t_out, 1);
                fm.write((uint8_t*)&pl, 4);
                fm.write((uint8_t*)&pn, 4);
                fm.write((uint8_t*)&lt, 4);
                fm.write((uint8_t*)&nn, 4);
              }
              pl = lt; pn = nn;
            }
          }
        }
      } else {
        pl = 0.0; pn = 0.0;
      }
      ps = 0;
    } else if (c == '.' || c == '-' || (c >= '0' && c <= '9')) {
      if (ps == 1) {
        if (s1.length() < 15) { s1 += c; }
      } else if (ps == 2) {
        if (s2.length() < 15) { s2 += c; }
      }
    } else {
      ps = 0; 
    }
  }
  
  fm.close();
  st.close();
  SD.remove(fn);
}

