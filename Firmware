void up() {
  HTTPUpload& l = w.upload();
  if (l.status == UPLOAD_FILE_START) {
    String tn = "";
    if (l.filename.startsWith("/")) {
      tn = l.filename;
    } else {
      tn = "/" + l.filename;
    }
    f = SD.open(tn, FILE_WRITE);
  } 
  if (l.status == UPLOAD_FILE_WRITE) {
    if (f) { f.write(l.buf, l.currentSize); }
  } 
  if (l.status == UPLOAD_FILE_END) {
    if (f) {
      String tn = "";
      if (l.filename.startsWith("/")) {
        tn = l.filename;
      } else {
        tn = "/" + l.filename;
      }
      f.close();
      
      String tl = tn;
      tl.toLowerCase();
      
      if (tl.endsWith(".gpx")) {
        n = tn;
        sv(n, "/last.txt");
        bb = false;
        zm = 1.0; 
        ox_m = 0.0; 
        oy_m = 0.0;
        a_c = true;
        cs = true; 
        g = true;
      } else if (tl.endsWith(".json") || tl.endsWith(".geojson")) {
        p_js(tn);
        cs = true; 
        g = true;
      }
    }
  }
}

