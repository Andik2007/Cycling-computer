void d_m() {
  File f2 = SD.open("/map.bin");
  if (f2) {
    float x_m = 240.0 / vx;
    float y_m = 320.0 / vy;
    
    float nx = vlx - (50.0 / x_m);
    float xx = vlx + (290.0 / x_m);
    float ny = vly - (50.0 / y_m); 
    float xy = vly + (370.0 / y_m);

    uint16_t c0;
    if (bg == ILI9341_BLACK) {
      c0 = ILI9341_DARKGREY;
    } else {
      c0 = ILI9341_LIGHTGREY;
    }

    static uint8_t* bf = NULL;
    if (bf == NULL) {
      bf = (uint8_t*)malloc(34000);
    }
    
    if (bf) {
      d.startWrite(); 
      
      while (f2.available()) {
        int r_c = f2.read(bf, 34000);
        int s_c = r_c / 17;
        
        for (int i = 0; i < s_c; i++) {
          int p = i * 17;
          uint8_t t = bf[p];
          
          float y1 = *(float*)(bf + p + 1);
          float x1 = *(float*)(bf + p + 5);
          float y2 = *(float*)(bf + p + 9);
          float x2 = *(float*)(bf + p + 13);

          if ((x1 < nx && x2 < nx) || (x1 > xx && x2 > xx) || (y1 < ny && y2 < ny) || (y1 > xy && y2 > xy)) {
            continue; 
          }

          int c_x1 = (x1 - vlx) * x_m;
          int c_y1 = 320 - ((y1 - vly) * y_m);
          int c_x2 = (x2 - vlx) * x_m;
          int c_y2 = 320 - ((y2 - vly) * y_m);

          if (c_x1 == c_x2) {
            if (c_y1 == c_y2) {
              continue; 
            }
          }

          uint16_t c = c0;
          if (t == 1) {
            c = ILI9341_RED;
          } else if (t == 2) {
            c = ILI9341_ORANGE;
          }
          
          d.writeLine(c_x1, c_y1, c_x2, c_y2, c); 
        }
        
        d.endWrite(); 
        yield(); 
        w.handleClient(); 
        ug(); 
        d.startWrite(); 
      }
      
      d.endWrite();
    }
    f2.close();
  }
}

void dr() {
  if (cs) {
    if (a_c) {
      if (u_ok) {
        ox_m = u_lo - ((lx + hx) / 2.0);
        oy_m = u_la - ((ly + hy) / 2.0);
      }
    }

    d.fillScreen(bg);
    d.setTextColor(tx, bg);
    d.setTextSize(2);

    if (!sk) {
      d.setCursor(10, 50);
      d.print("SD ERR: Check card");
      cs = false;
    } else if (n == "") {
      d.setCursor(10, 50);
      d.print("ERR: No File");
      cs = false;
    } else {
      if (!bb) {
        d.setCursor(10, 40);
        d.print("Init GPX Cache...");
        d.setCursor(10, 70);
        d.print(n);
        
        lx = 180.0; ly = 90.0; hx = -180.0; hy = -90.0;
        f = SD.open(n);
        
        if (SD.exists("/t.bin")) { SD.remove("/t.bin"); }
        File tb = SD.open("/t.bin", FILE_WRITE);
          
        if (f && tb) {
          char cb[256];
          int lc = 0;
          int pt = 0;
            
          while (f.available()) {
            lc++;
            if (lc > 50) {
              yield(); 
              w.handleClient();
              ug(); 
              lc = 0;
            }
            int sz = f.readBytesUntil('\n', cb, 255);
            cb[sz] = '\0';
            char* p1 = strstr(cb, "lat=\"");
            if (p1) {
              float y = atof(p1 + 5);
              char* p2 = strstr(cb, "lon=\"");
              if (p2) {
                float x = atof(p2 + 5);
                tb.write((uint8_t*)&x, 4);
                tb.write((uint8_t*)&y, 4);
                if (x < lx) { lx = x; }
                if (x > hx) { hx = x; }
                if (y < ly) { ly = y; }
                if (y > hy) { hy = y; }
                pt++;
              }
            }
          }
          f.close();
          tb.close();
          
          if (pt == 0) {
            d.fillScreen(bg);
            d.setCursor(10, 50);
            d.print("ERR: 0 points");
            n = ""; 
            cs = false;
          } else {
            float cl_c = cos(((ly + hy) / 2.0) * 3.1415926 / 180.0);
            float dw = (hx - lx) * cl_c;
            float dh = (hy - ly);
            if (dh == 0.0) { dh = 0.0001; }
            if (dw == 0.0) { dw = 0.0001; }
            
            if (dw / dh > 0.75) {
              float nh = dw / 0.75;
              float cy = (ly + hy) / 2.0;
              hy = cy + (nh / 2.0);
              ly = cy - (nh / 2.0);
            } else {
              float nw = dh * 0.75;
              float cx_c = (lx + hx) / 2.0;
              hx = cx_c + (nw / 2.0) / cl_c;
              lx = cx_c - (nw / 2.0) / cl_c;
            }
            bb = true;
            d.fillScreen(bg); 
          }
        } else {
          d.fillScreen(bg);
          d.setCursor(10, 50);
          d.print("ERR: Open failed");
          n = ""; 
          cs = false;
        }
      }
      
      if (bb) {
        vx = (hx - lx) / zm;
        vy = (hy - ly) / zm;
        if (vx == 0.0) { vx = 0.0001; }
        if (vy == 0.0) { vy = 0.0001; }
        
        float cx_m = (lx + hx) / 2.0 + ox_m;
        float cy_m = (ly + hy) / 2.0 + oy_m;
        vlx = cx_m - (vx / 2.0);
        vly = cy_m - (vy / 2.0);
        
        d_m(); 

        float x_m = 240.0 / vx;
        float y_m = 320.0 / vy;
        int p_x = -1, py_draw = -1;
        
        File tb = SD.open("/t.bin");
        if (tb) {
          static uint8_t* t_bf = NULL;
          if (t_bf == NULL) {
            t_bf = (uint8_t*)malloc(8000);
          }
          if (t_bf) {
            d.startWrite();
            while (tb.available()) {
              int r_c = tb.read(t_bf, 8000);
              int s_c = r_c / 8;
              
              for (int i = 0; i < s_c; i++) {
                float x = *(float*)(t_bf + i * 8);
                float y = *(float*)(t_bf + i * 8 + 4);
                
                int c_x = (x - vlx) * x_m;
                int c_y = 320 - ((y - vly) * y_m);

                if (p_x != -1) { 
                  if (p_x != c_x || py_draw != c_y) {
                    if (!((p_x < -50 && c_x < -50) || (p_x > 290 && c_x > 290) || (py_draw < -50 && c_y < -50) || (py_draw > 370 && c_y > 370))) {
                      d.writeLine(p_x, py_draw, c_x, c_y, rt);
                      d.writeLine(p_x + 1, py_draw, c_x + 1, c_y, rt);
                      d.writeLine(p_x, py_draw + 1, c_x, c_y + 1, rt);
                    }
                  }
                }
                p_x = c_x; py_draw = c_y;
              }
              d.endWrite();
              yield(); 
              w.handleClient(); 
              ug(); 
              d.startWrite();
            }
            d.endWrite();
          }
          tb.close();
        }
        cs = false;
      }
    }
  }

  if (sk) {
    if (n != "") {
      if (bb) {
        if (u_ok) {
          int c_x = (u_lo - vlx) * 240.0 / vx;
          int c_y = 320 - ((u_la - vly) * 320.0 / vy);

          if (c_x != ox || c_y != oy) {
            if (ox != -1) { 
              d.fillCircle(ox, oy, 4, bg); 
            }
            d.fillCircle(c_x, c_y, 4, ILI9341_RED);
            ox = c_x; oy = c_y;
          }
        }
      }
    }
  }
  
  d.setTextSize(2);
  
  if (u_sp != c_sp) {
    d.setCursor(10, 5); 
    d.setTextColor(cl(u_sp), bg); 
    d.print(u_sp, 1); 
    d.setTextColor(tx, bg); 
    d.print("   ");
    c_sp = u_sp;
  }
  
  int sat = 0;
  if (u_ph) {
    sat = 99;
  } else {
    if (tg.satellites.isValid()) {
      sat = tg.satellites.value();
    }
  }

  if (sat != c_st) {
    d.setCursor(200, 5); 
    if (sat == 99) {
      d.print("PH "); 
    } else {
      d.print(sat); 
      d.print("   "); 
    }
    c_st = sat;
  }
}

void setup() {
  Serial.begin(115200);
  gs.begin(9600, SERIAL_8N1, 17, 16); 
  delay(1000); 

  pinMode(10, OUTPUT); 
  digitalWrite(10, HIGH);
  
  pinMode(6, OUTPUT);
  digitalWrite(6, HIGH);

  pinMode(14, OUTPUT);
  digitalWrite(14, HIGH);
  
  pinMode(7, INPUT_PULLUP);

  SPI.end(); 
  SPI.begin(12, 13, 11, -1); 

  SPI.beginTransaction(SPISettings(2000000, MSBFIRST, SPI_MODE0));
  digitalWrite(14, LOW);
  SPI.transfer(0x80); 
  digitalWrite(14, HIGH);
  SPI.endTransaction();

  d.begin();
  d.setRotation(0); 
  
  tc.begin();
  tc.setRotation(0);

  b2.begin(18, 19, 21, -1); 

  Wire.begin(4, 5); 
  if (ah.begin()) {
    ah_ok = true;
  }
  
  if (SD.begin(15, b2, 40000000)) { 
    sk = true;
    if (SD.exists("/last.txt")) {
      File c = SD.open("/last.txt");
      if (c) {
        n = c.readString();
        c.close();
        n.trim();
      }
    }
    if (!SD.exists(n)) {
      File rt = SD.open("/");
      while (File e = rt.openNextFile()) {
        String m = e.name();
        if (!e.isDirectory()) {
          String tl = m;
          tl.toLowerCase();
          if (tl.endsWith(".gpx")) {
            if (m.startsWith("/")) {
              n = m;
            } else {
              n = "/" + m;
            }
            break;
          }
        }
      }
    }
  } else {
    sk = false;
  }

  WiFi.mode(WIFI_AP);
  WiFi.softAP("ESP32-Gravel", "12345678");

  w.on("/", HTTP_GET, pg);
  w.on("/sw", HTTP_GET, ssw);
  w.on("/slp", HTTP_GET, s_slp);
  w.on("/zm", HTTP_GET, s_zm); 
  w.on("/mv", HTTP_GET, s_mv); 
  w.on("/ac", HTTP_GET, s_ac); 
  w.on("/pgps", HTTP_GET, s_pgps); 
  w.on("/t_tg", HTTP_GET, t_tg);
  w.on("/t_cl", HTTP_GET, t_cl);
  w.on("/up", HTTP_POST, ok, up);
  w.on("/ls", HTTP_GET, gls); 
  w.on("/dr", HTTP_GET, sdr);
  w.on("/dl", HTTP_GET, d_dl); 
  w.begin();
  
  cur_n = is_n();
  if (cur_n) {
    bg = ILI9341_BLACK;
    tx = ILI9341_WHITE;
    rt = ILI9341_CYAN;
  } else {
    bg = ILI9341_WHITE;
    tx = ILI9341_BLACK;
    rt = ILI9341_BLUE;
  }
  
  cs = true; 
  g = true; 
}

void loop() {
  w.handleClient();
  ug(); 

  bool tch = (digitalRead(7) == LOW);
  if (tch) {
    if (!p_tc) {
      uint32_t m = millis();
      if (m - t_t < 400 && m - t_t > 50) {
        t_c = 2;
        t_t = m;
      } else {
        t_c = 1;
        t_t = m;
        TS_Point p = tc.getPoint();
        l_tx = map(p.x, 300, 3800, 0, 240);
        l_ty = map(p.y, 300, 3800, 0, 320);
      }
    }
    p_tc = true;
  } else {
    p_tc = false;
  }

  if (t_c == 1) {
    if (millis() - t_t > 400) {
      if (vm == 2) {
        if (l_ty > 20 && l_ty < 80) { t_tg(); pm = -1; g = true; }
        if (l_ty > 100 && l_ty < 160) { t_cl(); pm = -1; g = true; }
        if (l_ty > 180 && l_ty < 240) { s_slp(); }
      }
      t_c = 0;
    }
  } else if (t_c == 2) {
    vm++;
    if (vm > 2) {
      vm = 0;
    }
    pm = -1;
    cs = true;
    g = true;
    t_c = 0;
  }

  bool n_now = is_n();
  if (n_now != cur_n) {
    cur_n = n_now;
    if (cur_n) {
      bg = ILI9341_BLACK;
      tx = ILI9341_WHITE;
      rt = ILI9341_CYAN;
    } else {
      bg = ILI9341_WHITE;
      tx = ILI9341_BLACK;
      rt = ILI9341_BLUE;
    }
    pm = -1; 
    cs = true; 
    g = true;
  }

  if (sl_r) {
    sl_r = false;
    
    digitalWrite(6, LOW); 
    d.sendCommand(0x10);
    
    WiFi.mode(WIFI_OFF);
    
    pinMode(7, INPUT_PULLUP);
    gpio_wakeup_enable(GPIO_NUM_7, GPIO_INTR_LOW_LEVEL);
    esp_sleep_enable_gpio_wakeup();

    bool wk = false;
    while (!wk) {
      esp_light_sleep_start(); 
      
      while (digitalRead(7) == LOW) {
        yield();
      }
      
      delay(50); 
      uint32_t tw = millis();
      
      while (millis() - tw < 500) {
        if (digitalRead(7) == LOW) {
          wk = true;
          break;
        }
      }
    }

    d.sendCommand(0x11);
    delay(120); 
    digitalWrite(6, HIGH); 
    
    WiFi.mode(WIFI_AP);
    WiFi.softAP("ESP32-Gravel", "12345678");
    w.begin();
    
    pm = -1; 
    cs = true; 
    g = true; 
  }
  
  if (g || (millis() - lu > 1000)) {
    g = false;
    lu = millis();
    
    if (vm != pm) {
      d.fillScreen(bg);
      pm = vm;
      cs = true; 
      
      c_sp = -1.0; c_as = -1.0; c_ds = -1.0; c_mx = -1.0;
      c_h = -1; c_m = -1; c_th = -1; c_tm = -1; c_ts = -1; c_st = -1;
      c_t = -999.0; c_hm = -999.0;
      c_bp = -1; 
    }
    
    if (vm == 0) {
      dr();
    } else if (vm == 1) {
      dd();
    } else if (vm == 2) {
      db();
    }
  }
}
